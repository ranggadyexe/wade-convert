# Salin ke .env lalu sesuaikan. Jangan commit .env.

# --- API ---
API_PORT=8000
# Batas ukuran unggahan (MB)
MAX_UPLOAD_MB=20
# Batas halaman PDF yang diproses
MAX_PDF_PAGES=100
# File sementara dihapus setelah N menit
FILE_TTL_MINUTES=15
# Direktori penyimpanan sementara di dalam container
STORAGE_DIR=/tmp/wade-convert
# Batas waktu satu job konversi (detik)
JOB_TIMEOUT_SECONDS=120
# Rate limit per IP (permintaan per menit)
RATE_LIMIT_PER_MINUTE=20
# Origin frontend yang diizinkan (CORS), pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
